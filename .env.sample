# muckscraperHeadlinesGoogleNEW/.env.sample
NEWS_API_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_key_here
POSTGRES_USER=postgres  # you should probably change this
POSTGRES_PASSWORD=default1 # maybe this one too?
POSTGRES_DB=aggregator # stop being lazy, don't use the defaults!
# Number of gunicorn worker processes for the read-only API (default 2).
GUNICORN_WORKERS=2
SECRET_KEY=generate_with_python3_-c_import_secrets_print_secrets.token_hex_32
# Time zone the aggregator shows times in. Use an IANA name for where you
# are, e.g. America/New_York, Europe/London, Australia/Sydney (full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones). Defaults to UTC.
DISPLAY_TIMEZONE=UTC
# MuckScraper uses a shared Ollama API. The Sandbox Protocol deployment
# publishes a loopback-only host endpoint and a dedicated internal Docker
# network. MuckScraper reaches the service through that internal network;
# change this only for a deliberately chosen compatible Ollama endpoint.
OLLAMA_HOST=http://ollama:11434
# The shared local-model profile is qwen2.5:3b-instruct (quality),
# qwen2.5:1.5b-instruct (fast), and nomic-embed-text:v1.5 (embeddings).
# Its storage is owned by the shared Ollama service, never by this checkout.
# See docs/local-model-profile.md.
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=replace_with_a_real_meilisearch_key
