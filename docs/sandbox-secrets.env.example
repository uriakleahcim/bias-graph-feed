# Copy this file to:
# /home/uriak/sandbox/groups/agent-services/muckscraper/config/secrets.env
# Then replace every value. Keep that runtime file mode 600; it is not source.

POSTGRES_USER=muckscraper
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=muckscraper
SECRET_KEY=replace-with-a-random-64-hex-character-value
MEILI_MASTER_KEY=replace-with-a-long-random-key
# Resolve these only when Docker Compose runs. Do not paste the API keys into
# this file. The saved provider credential is NEWSAPI_API_KEY; it is mapped to
# Bias Graph Feed's application-facing NEWS_API_KEY at startup.
NEWS_API_KEY=${NEWSAPI_API_KEY:?NEWSAPI_API_KEY must be exported before sandbox start}
GNEWS_API_KEY=${GNEWS_API_KEY:?GNEWS_API_KEY must be exported before sandbox start}

# Sandbox Protocol supplies this path itself. Leave it in the runtime file only
# when running Compose outside the Sandbox command.
# MUCKSCRAPER_RUNTIME_ROOT=/home/uriak/sandbox/groups/agent-services/muckscraper
